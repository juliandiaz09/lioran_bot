# ===== General =====
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
LOG_USER_TEXT=false              # true solo en depuración: registra el texto del usuario en logs

# ===== Seguridad servicio a servicio =====
SERVICE_API_KEY=cambia-esta-llave     # cabecera X-API-Key que envía n8n
ADMIN_API_KEY=cambia-esta-llave-admin # protege POST /v1/rag/documents

# ===== Fusión de clasificadores (fusión tardía) =====
FUSION_WEIGHT_ENCODER=0.5
FUSION_WEIGHT_LLM=0.5

# ===== Riesgo / bandido / RAG =====
RISK_HISTORY_WINDOW=5            # mensajes recientes considerados para el riesgo por historial
BANDIT_MIN_OBSERVATIONS=20       # por debajo de N, mezcla con política por reglas
BANDIT_SEED=                     # vacío = aleatorio; entero = reproducible
RAG_TOP_K=4

# ===== Tiempos límite (s) y límites del flujo principal =====
CLASSIFICATION_TIMEOUT_S=6.0
GENERATION_TIMEOUT_S=8.0
PERSISTENCE_TIMEOUT_S=3.0
CRISIS_LOOKUP_TIMEOUT_S=1.0     # la ruta de crisis debe responder en <= 2 s
MAX_MESSAGE_LENGTH=2000
MAX_REGENERATIONS=1             # reintentos si el validador rechaza la respuesta

# ===== Configuración declarativa (archivos versionados) =====
SECONDARY_EMOTIONS_FILE=         # vacío = reglas por defecto del dominio
RISK_LEXICON_FILE=config/risk_lexicon.yaml   # léxico de riesgo versionado (BORRADOR: pendiente de revisión)
TEMPLATES_DIR=config/templates               # plantillas de crisis y segura (PENDIENTES DE APROBACIÓN)

# ===== Adaptadores: se elige cuál usar SOLO por configuración =====
# Con ENCODER_BACKEND=stub, LLM_BACKEND=fake, PERSISTENCE_BACKEND=memory y RETRIEVER_BACKEND=memory
# el sistema corre sin dependencias externas (pruebas y desarrollo).

# --- Encoder (clasificador de emociones)
ENCODER_BACKEND=stub             # stub | hf   (hf requiere el extra: pip install ".[ml]")
ENCODER_MODEL_PATH=models/encoder  # carpeta LOCAL del modelo ajustado; NO se descarga de HuggingFace
ENCODER_MODEL_NAME=pysentimiento/robertuito-emotion-analysis   # solo informativo (logs)
ENCODER_TEMPERATURE_FILE=config/encoder_temperature.json       # {"temperature": 1.0}; si no existe, T=1.0
ENCODER_DEVICE=cpu

# --- LLM (cualquier API compatible con OpenAI: POST {LLM_BASE_URL}/chat/completions)
LLM_BACKEND=fake                 # fake | openai_compatible
LLM_BASE_URL=                    # p. ej. https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20.0               # tiempo límite de cada llamada HTTP
LLM_MAX_RETRIES=2                # reintentos ante 429/5xx/timeout/conexión (4xx != 429 no se reintentan)
PROMPTS_DIR=prompts

# --- Persistencia y RAG
PERSISTENCE_BACKEND=memory       # memory | postgres   (postgres requiere el extra: pip install ".[db]")
RETRIEVER_BACKEND=memory         # memory | pgvector   (pgvector exige PERSISTENCE_BACKEND=postgres)
DATABASE_URL=                    # postgresql+asyncpg://usuario:clave@host:puerto/bd  (ver nota Supabase en el README)
DB_POOL_SIZE=5
STORE_USER_TEXT=true             # false => messages.texto = '[omitido]' (y comentario de feedback = NULL)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384                # debe coincidir con el modelo y con vector(N) de la migración
STRATEGIES_FILE=config/strategies.yaml

# --- Solo pruebas de integración (se saltan solas si está vacío)
TEST_DATABASE_URL=
